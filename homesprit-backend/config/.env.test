# Homesprit Backend - Test overrides (tests/conftest.py sets ENVIRONMENT=test).
# The suite builds its own SQLite databases; nothing here points at Postgres.

ENVIRONMENT=test
DEBUG=false
LOG_LEVEL=WARNING
LOG_FILE=
DATABASE_URL=sqlite://
SETUP_ADMIN=false
CORS_ORIGINS=["http://localhost:3002"]
# Test-only signing key: long enough for HS256 so PyJWT does not warn. It signs
# nothing outside the suite.
SECRET_KEY=test-only-signing-key-never-used-outside-the-suite
