# Homesprit Backend - Base Configuration
# Common to every environment. NO SECRETS IN THIS FILE — it is committed.
# Secrets (DATABASE_URL, SECRET_KEY, ADMIN_PASSWORD) belong in the gitignored
# root .env locally, or in the host's environment when deployed.

APP_NAME="Homesprit Backend"
APP_VERSION="1.0.0"

HOST=0.0.0.0
PORT=8001

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000

LOG_FILE=logs/app.log

ALGORITHM=HS256
# A working week.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ADMIN_NAME="Homesprit Admin"
