# Homesprit Backend - Production overrides
# Still no secrets: DATABASE_URL, SECRET_KEY and ADMIN_PASSWORD come from the
# host environment.

ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=WARNING

# The deployed Next.js origin. Must be exact — allow_credentials forbids "*".
CORS_ORIGINS=["https://www.homesprit.example"]

# Create the first admin once, deliberately, then set this back to false so a
# restart can never recreate a deactivated account.
SETUP_ADMIN=false
