# Copy this file to `.env` in this directory and fill in the real values.
# `.env` is gitignored — never commit real credentials.
#
# Loading order (later wins): config/.env.base -> config/.env.{ENVIRONMENT} -> .env

# dev | prod. Outside dev the app refuses the placeholder SECRET_KEY and refuses
# to boot against an out-of-date schema.
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# A dedicated PostgreSQL database. Create it first:
#   createdb -U postgres homesprit
# If the password contains @ : / ? # or %, URL-encode it (@ -> %40).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@localhost:5432/homesprit

# Signs every access token. Changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# The Next.js site's origin (homesprit-frontend runs on 3002).
CORS_ORIGINS=["http://localhost:3002"]

# Initial admin — created on startup only if absent, never overwritten.
SETUP_ADMIN=true
ADMIN_EMAIL=admin@homesprit.dev
ADMIN_PASSWORD=
ADMIN_NAME=Homesprit Admin

# Password given to the demo agents by scripts/seed_demo_data.py (dev only).
DEMO_AGENT_PASSWORD=
