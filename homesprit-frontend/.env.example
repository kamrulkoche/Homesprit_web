# Copy to `.env.local` (gitignored) and restart `npm run dev` after editing —
# Next.js reads env files only at startup.

# The homesprit-backend origin. SERVER-ONLY, deliberately un-prefixed, exactly
# as hgs-frontend's HGS_BACKEND_URL: the browser never learns it. Server
# Components read it directly; everything the browser needs goes through this
# app's own route handlers (/api/public/*, /api/admin/*, /api/inquiries).
HOMESPRIT_BACKEND_URL=http://localhost:8001

# OPTIONAL. The browser's axios base for the Redux/saga layer. Defaults to the
# relative `/api/public` proxy; only set an absolute origin if the backend is
# ever exposed to the browser directly.
# NEXT_PUBLIC_API_BASE_URL=/api/public

# OPTIONAL. Used only to absolutise the relative base above for a server-side
# caller. Must match the port `npm run dev` serves on.
# NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3002

# OPTIONAL. Canonical origin for metadata and the sitemap.
# NEXT_PUBLIC_SITE_URL=http://localhost:3002
